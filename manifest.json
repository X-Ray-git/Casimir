{
  "manifest_version": 3,
  "name": "Casimir",
  "description": "A focused Chrome extension connecting research reading with ChatGPT workflows.",
  "version": "0.5.0",
  "minimum_chrome_version": "140",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "debugger",
    "pageCapture",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://cdn.openai.com/*",
    "https://www.alphaxiv.org/*",
    "https://www.nature.com/*",
    "https://aclanthology.org/*",
    "https://openreview.net/*",
    "https://x.com/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "src/background/arxiv-split-view.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.alphaxiv.org/abs/*",
        "https://www.alphaxiv.org/pdf/*",
        "https://www.nature.com/articles/*",
        "https://aclanthology.org/*",
        "https://openreview.net/forum*",
        "https://x.com/*/article/*"
      ],
      "js": [
        "src/content/paper-source.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://arxiv.org/abs/*"
      ],
      "js": [
        "src/content/arxiv-first-visit.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://academy.dair.ai/papers/*"
      ],
      "js": [
        "src/content/arxiv-first-visit.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content/chatgpt-shortcuts.js",
        "src/content/chatgpt-pdf-upload.js",
        "src/content/chatgpt-rate-limit-dismiss.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
